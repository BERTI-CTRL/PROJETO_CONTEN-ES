\chapter{Equilíbrio do muro}
\section{Peso próprio: retângulo mais triângulo}
A seção trapezoidal é dividida em um retângulo e um triângulo. Para o retângulo, a largura é $t$; para o triângulo, a base horizontal é $b-t$. As áreas são calculadas por metro de comprimento:
\begin{align*}
A_{ret}&=tH={{ entradas.t }}\times{{ entradas.H }}={{ retangulo.area }}\,\mathrm{m^2},\\
W_{ret}&=A_{ret}\gamma_c={{ retangulo.area }}\times{{ retangulo.gamma }}={{ retangulo.peso }}\,\mathrm{kN/m},\\
x_{ret}&=b-\frac{t}{2}={{ entradas.b }}-\frac{{ entradas.t }}2={{ retangulo.braco }}\,\mathrm{m},\\
M_{ret}&=W_{ret}x_{ret}={{ retangulo.peso }}\times{{ retangulo.braco }}={{ retangulo.momento }}\,\mathrm{kN\cdot m/m}.
\end{align*}
\begin{align*}
A_{tri}&=\frac{(b-t)H}{2}=\frac{({{ entradas.b }}-{{ entradas.t }})\times{{ entradas.H }}}2={{ triangulo.area }}\,\mathrm{m^2},\\
W_{tri}&=A_{tri}\gamma_c={{ triangulo.area }}\times{{ triangulo.gamma }}={{ triangulo.peso }}\,\mathrm{kN/m},\\
x_{tri}&=\frac{2(b-t)}3=\frac{2({{ entradas.b }}-{{ entradas.t }})}3={{ triangulo.braco }}\,\mathrm{m},\\
M_{tri}&=W_{tri}x_{tri}={{ triangulo.peso }}\times{{ triangulo.braco }}={{ triangulo.momento }}\,\mathrm{kN\cdot m/m}.
\end{align*}
Assim, o peso próprio total é $W=W_{ret}+W_{tri}={{ retangulo.peso }}+{{ triangulo.peso }}={{ resumo.peso_muro_kN_m}}\,\mathrm{kN/m}$.

\section{Forças e momentos resultantes}
Os empuxos e seus braços são somados trecho a trecho. Para o método Coulomb, o empuxo de solo e sobrecarga é decomposto conforme $\delta$; a pressão de água segue horizontalmente.
\begin{align*}
E_s&={{ resumo.empuxo_solo_kN_m}}\,\mathrm{kN/m},&M_s&={{ resumo.momento_solo_ponta_kNm_m}}\,\mathrm{kN\cdot m/m},\\
E_q&={{ resumo.empuxo_sobrecarga_kN_m}}\,\mathrm{kN/m},&M_q&={{ resumo.momento_sobrecarga_ponta_kNm_m}}\,\mathrm{kN\cdot m/m},\\
E_w&={{ resumo.empuxo_hidrostatico_kN_m}}\,\mathrm{kN/m},&M_w&={{ resumo.momento_hidrostatico_ponta_kNm_m}}\,\mathrm{kN\cdot m/m}.
\end{align*}
\begin{align*}
H_{tot}&=(E_s+E_q)\cos\delta+E_w={{ resumo.componente_horizontal_total_kN_m}}\,\mathrm{kN/m},\\
V_d&=(E_s+E_q)\sin\delta={{ resumo.componente_vertical_descendente_kN_m}}\,\mathrm{kN/m},\\
V&=W+V_d={{ resumo.peso_muro_kN_m}}+{{ resumo.componente_vertical_descendente_kN_m}}={{ resumo.carga_vertical_total_kN_m}}\,\mathrm{kN/m},\\
M_{tomb}&=(M_s+M_q)\cos\delta+M_w={{ resumo.momento_tombador_ponta_kNm_m}}\,\mathrm{kN\cdot m/m},\\
M_{est}&=M_{tri}+M_{ret}+V_db={{ triangulo.momento }}+{{ retangulo.momento }}+{{ resumo.componente_vertical_descendente_kN_m}}\times{{ entradas.b }}={{ resumo.momento_estabilizador_total_kNm_m}}\,\mathrm{kN\cdot m/m}.
\end{align*}
